exports[`aws.auth.demo.plan given: [case1] a caller who asks for help when: [t0] --help is passed then: it exits 0 and shows usage and the never-apply guarantee 1`] = `
"🐢 here's the deal...

🐚 aws.auth.demo.plan — plan the demo auth resources, read-only
   ├─ usage
   │  └─ rhx aws.auth.demo.plan
   ├─ inputs, none passed by hand
   │  ├─ creds: keyrack env test, unlocked for you
   │  └─ reach pair: GROVE_REACH_CAMP_ACCOUNT_ID + GROVE_REACH_CAMP_ROLE_NAME
   │     └─ read from: provision/aws.auth/account=demo/.env, else the shell, else the live role
   ├─ options
   │  └─ --help   show this help
   ├─ example
   │  └─ rhx aws.auth.demo.plan   # then read the tally: one UPDATE per intended change
   └─ never applies; writes provision/aws.auth/account=demo/.temp/plan.readonly.json
"
`;

