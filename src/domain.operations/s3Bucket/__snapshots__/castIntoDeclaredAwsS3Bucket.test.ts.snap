exports[`castIntoDeclaredAwsS3Bucket given: [case8] a transition to a storage class this package does not model when: [t0] the reads are cast then: it fails loud and names the bucket, field, value, modeled set, and fix (F8) 1`] = `
{
  "message": "UnexpectedCodePathError: bucket "my-bucket" reads lifecycle.objects.transitions[].class = "ONEZONE_IA", a value declastruct-aws does not model (modeled: STANDARD_IA, GLACIER_IR, GLACIER, DEEP_ARCHIVE, INTELLIGENT_TIERING). it fails loud rather than guess, since a guess would skew the plan. fix: upgrade declastruct-aws; if already on the latest, file an issue at ehmpathy/declastruct-aws that names this field and value

{
  "bucket": "my-bucket",
  "field": "lifecycle.objects.transitions[].class",
  "value": "ONEZONE_IA",
  "modeled": [
    "STANDARD_IA",
    "GLACIER_IR",
    "GLACIER",
    "DEEP_ARCHIVE",
    "INTELLIGENT_TIERING"
  ]
}",
}
`;

