// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`delBucket given: [case1] a bucket that still holds an object when: [t0] the bucket is deleted then: it fails loud with the named BucketNotEmpty error 1`] = `
{
  "message": "BadRequestError: BucketNotEmpty: bucket "<bucket>" still holds contents. aws counts object VERSIONS and DELETE MARKERS as contents, so on a bucket whose versions are (or were) enabled, \`aws s3 rm --recursive\` does not empty it — each delete writes a marker, and each marker is itself a version. a versions status of 'suspended' does NOT undo this. fix: remove every version and marker, which needs \`s3:DeleteObjectVersion\` (use admin credentials): \`aws s3api list-object-versions --bucket <bucket>\`, then \`aws s3api delete-object --bucket <bucket> --key <key> --version-id <versionId>\` for each. note: a bucket name is GLOBAL — until this is cleared, the name is unusable everywhere

{
  "bucket": "<bucket>",
  "awsMessage": "The bucket you tried to delete is not empty"
}",
}
`;
